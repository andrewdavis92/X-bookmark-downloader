# X Bookmark Downloader - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED - X API Credentials
# ============================================================================
# Get your bearer token from https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_bearer_token_here

# ============================================================================
# OPTIONAL - Path Configuration (overrides config.yaml/json)
# ============================================================================
# Download directory for bookmarks
# BOOKMARK_DOWNLOADER_PATHS_DOWNLOADS_DIRECTORY=~/Documents/X-Bookmarks

# Logs directory (logs, state.db, quarantine)
# BOOKMARK_DOWNLOADER_PATHS_LOGS_DIRECTORY=~/Library/Logs/bookmark-downloader

# ============================================================================
# OPTIONAL - Download Settings
# ============================================================================
# Maximum worker threads for parallel downloads
# BOOKMARK_DOWNLOADER_DOWNLOAD_MAX_WORKERS=4

# Video quality preference (best, 720p, 480p, etc.)
# BOOKMARK_DOWNLOADER_DOWNLOAD_VIDEO_QUALITY=best

# Request timeout in seconds
# BOOKMARK_DOWNLOADER_DOWNLOAD_TIMEOUT_SECONDS=600

# Number of retry attempts for failed downloads
# BOOKMARK_DOWNLOADER_DOWNLOAD_RETRY_ATTEMPTS=3

# ============================================================================
# OPTIONAL - State Management
# ============================================================================
# Tracking method: local_logging, bookmark_removal, or hybrid
# BOOKMARK_DOWNLOADER_STATE_MANAGEMENT_TRACKING_METHOD=local_logging

# How many days to keep processing history
# BOOKMARK_DOWNLOADER_STATE_MANAGEMENT_RETENTION_DAYS=90

# ============================================================================
# OPTIONAL - Logging
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# BOOKMARK_DOWNLOADER_LOGGING_LEVEL=INFO

# Log filename
# BOOKMARK_DOWNLOADER_LOGGING_FILENAME=bookmark_downloader.log

# ============================================================================
# Notes:
# - All environment variables are optional except TWITTER_BEARER_TOKEN
# - Environment variables override settings in config.yaml or config.json
# - Format: BOOKMARK_DOWNLOADER_SECTION_KEY (all uppercase, underscores for separators)
# ============================================================================
